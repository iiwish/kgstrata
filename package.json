{
  "name": "kgstrata",
  "version": "0.1.0",
  "description": "Layered 3D knowledge graphs: an ontology layer, a physical layer and the mappings between them, rendered with three.js.",
  "keywords": [
    "knowledge-graph",
    "ontology",
    "3d",
    "three",
    "threejs",
    "graph-visualization",
    "react",
    "data-lineage",
    "kgdiff"
  ],
  "homepage": "https://github.com/iiwish/kgstrata#readme",
  "bugs": {
    "url": "https://github.com/iiwish/kgstrata/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiwish/kgstrata.git"
  },
  "license": "MIT",
  "author": "iiwish",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./path": {
      "types": "./dist/path/index.d.ts",
      "default": "./dist/path/index.js"
    },
    "./diff": {
      "types": "./dist/diff/index.d.ts",
      "default": "./dist/diff/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "default": "./dist/headless.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/path": {
      "types": "./dist/react/path.d.ts",
      "default": "./dist/react/path.js"
    },
    "./react/diff": {
      "types": "./dist/react/diff.d.ts",
      "default": "./dist/react/diff.js"
    },
    "./react/styles.css": {
      "types": "./dist/react/styles.d.ts",
      "default": "./dist/react/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite -c demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "tsc -b && vite build -c demo/vite.config.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:pack": "node scripts/check-pack.mjs",
    "build:examples": "pnpm --filter \"./examples/*\" -r run typecheck && pnpm --filter \"./examples/*\" -r run build",
    "prepublishOnly": "pnpm build && pnpm check:pack"
  },
  "dependencies": {
    "d3-force": "3.0.1"
  },
  "peerDependencies": {
    "@kgdiff/core": "^0.12.1",
    "@kgdiff/layout": "^0.12.1",
    "@kgdiff/scene": "^0.12.1",
    "@types/three": ">=0.170.0 <0.200.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": ">=0.170.0 <0.200.0"
  },
  "peerDependenciesMeta": {
    "@kgdiff/core": {
      "optional": true
    },
    "@kgdiff/layout": {
      "optional": true
    },
    "@kgdiff/scene": {
      "optional": true
    },
    "@types/three": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kgdiff/core": "0.12.1",
    "@kgdiff/layout": "0.12.1",
    "@kgdiff/scene": "0.12.1",
    "@types/d3-force": "3.0.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
